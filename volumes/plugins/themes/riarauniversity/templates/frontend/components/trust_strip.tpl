{**
 * Riara University — indexing & trust badges with service logos.
 *}
<aside class="riara-trust" aria-label="{translate key="plugins.themes.riarauniversity.trust.ariaLabel"}">
	<div class="riara-trust__inner">
		<p class="riara-trust__label">{translate key="plugins.themes.riarauniversity.trust.label"}</p>
		<ul class="riara-trust__badges">
			<li>
				<a class="riara-trust__badge" href="https://www.budapestopenaccessinitiative.org/" rel="noopener noreferrer" target="_blank">
					<img class="riara-trust__logo" src="{$baseUrl}/plugins/themes/riarauniversity/images/trust/open-access.svg" alt="" width="96" height="26" loading="lazy">
					<span class="pkp_screen_reader">{translate key="plugins.themes.riarauniversity.trust.openAccess"}</span>
				</a>
			</li>
			<li>
				<span class="riara-trust__badge riara-trust__badge--static">
					<img class="riara-trust__logo" src="{$baseUrl}/plugins/themes/riarauniversity/images/trust/crossref.svg" alt="" width="96" height="26" loading="lazy">
					<span class="pkp_screen_reader">{translate key="plugins.themes.riarauniversity.trust.doi"}</span>
				</span>
			</li>
			<li>
				<a class="riara-trust__badge" href="https://doaj.org/" rel="noopener noreferrer" target="_blank">
					<img class="riara-trust__logo" src="{$baseUrl}/plugins/themes/riarauniversity/images/trust/doaj.svg" alt="" width="80" height="26" loading="lazy">
					<span class="pkp_screen_reader">DOAJ</span>
				</a>
			</li>
			<li>
				<a class="riara-trust__badge" href="https://scholar.google.com/" rel="noopener noreferrer" target="_blank">
					<img class="riara-trust__logo" src="{$baseUrl}/plugins/themes/riarauniversity/images/trust/google-scholar.svg" alt="" width="112" height="26" loading="lazy">
					<span class="pkp_screen_reader">{translate key="plugins.themes.riarauniversity.trust.scholar"}</span>
				</a>
			</li>
			<li>
				<a class="riara-trust__badge" href="https://orcid.org/" rel="noopener noreferrer" target="_blank">
					<img class="riara-trust__logo" src="{$baseUrl}/plugins/themes/riarauniversity/images/trust/orcid.svg" alt="" width="72" height="26" loading="lazy">
					<span class="pkp_screen_reader">{translate key="plugins.themes.riarauniversity.trust.orcid"}</span>
				</a>
			</li>
		</ul>
	</div>
</aside>
