### Source of the image ---------------------------------------------------------
# - pkpofficial: To RUN the official images published on DockerHub (default).
# - docker-io/pkpofficial: To RUN the images published on your external registry.
# - local: To BUILD an image locally (experts only)
IMAGE_SOURCE=pkpofficial

### Build / Run Parameters ------------------------------------------------------

# Tool to run or build. Options: ojs, omp, ops
PKP_TOOL=ojs

# REPLACE to set the version
PKP_VERSION="3_5_0-4"

# BUILD variable (experts only)
WEB_SERVER="php:8.3-apache"

### Production checklist (before go-live) ---------------------------------------

# Set OJS_ENV=production only when deploying — render-config.php will reject placeholder secrets.
# OJS_ENV=development

# 1. Set strong DB_PASS and rotate OJS_APP_KEY / OJS_SALT in .env
# 2. Run: php volumes/scripts/render-config.php --force --strict
# 3. Set base_url to your public HTTPS URL
# 4. Extend allowed_hosts in pkp.config.inc.php with your production domain(s)
# 5. Enable captcha and set force_ssl = On in [security]
# 6. Export CI seed after setup: ./volumes/scripts/export-db-seed.sh
# 7. Enable scheduled backups: docker compose -f docker-compose.yml -f docker-compose.backup.yml --profile backup up -d
#    Keep DB_PASS in .env in sync via render-config.php (see volumes/config/pkp.config.inc.php.example)

TZ=Africa/Nairobi

### Database Settings -----------------------------------------------------------

DB_VERSION="mariadb:11.8"
DB_HOST="db"
DB_NAME="pkp"
DB_USER="pkp"

# REPLACE with a strong password before deploying.
DB_PASS="changeMePlease"

# OJS secrets (rendered into volumes/config/pkp.config.inc.php)
# Generate a new app key for production: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
OJS_APP_KEY="base64:REPLACE_ME_GENERATE_A_NEW_KEY"
OJS_SALT="YouMustSetASecretKeyHere!!"
OJS_BASE_URL="http://127.0.0.1:8888"

### Journal identifiers & integrations (optional — bootstrap-journal-services.php) -------

# Online ISSN (use "Pending assignment" until assigned)
OJS_ONLINE_ISSN="Pending assignment"
# OJS_PRINT_ISSN=""

# Crossref test prefix (replace with your registered prefix in production)
OJS_DOI_PREFIX="10.55555"
OJS_PUBLISHER="Riara University"
OJS_CROSSREF_DEPOSITOR_NAME="Riara University Journal"
OJS_CROSSREF_DEPOSITOR_EMAIL="dgetaro@riarauniversity.ac.ke"
OJS_CROSSREF_TEST_MODE="1"

# ORCID (leave empty to keep ORCID disabled until credentials are ready)
# OJS_ORCID_CLIENT_ID=""
# OJS_ORCID_CLIENT_SECRET=""

# Google Sign-In (bootstrap-google-oauth.php; configure redirect URI in Google Cloud console)
# OJS_GOOGLE_CLIENT_ID=""
# OJS_GOOGLE_CLIENT_SECRET=""
# OJS_GOOGLE_TEST_CREDENTIALS="1"

# Optional faculty journals cloned from the primary journal (pipe-separated path:Name pairs)
# OJS_FACULTY_JOURNALS="law:Riara Law Journal|engineering:School of Engineering Journal"

# Google Analytics 4 measurement ID (leave empty to skip)
# OJS_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

### SMTP (optional — production editorial mail) ---------------------------------

# Leave OJS_SMTP_SERVER empty to use sendmail inside the container (local dev).
# OJS_SMTP_SERVER="smtp.riarauniversity.ac.ke"
# OJS_SMTP_PORT="587"
# OJS_SMTP_AUTH="tls"
# OJS_SMTP_USERNAME="journals@riarauniversity.ac.ke"
# OJS_SMTP_PASSWORD=""
# OJS_SMTP_ENVELOPE="journals@riarauniversity.ac.ke"

### Backups (optional — backup.sh + docker-compose.backup.yml) ------------------

# Cron schedule when using the backup-cron sidecar (minute hour dom month dow)
# BACKUP_CRON_SCHEDULE="0 2 * * *"

# Copy each backup stamp here after local archive (NAS mount, secondary disk, etc.)
# BACKUP_REMOTE_DIR="/mnt/nas/ojs-riara-backups"

### Journal / Project Settings --------------------------------------------------

COMPOSE_PROJECT_NAME="ojs-riara"
PROJECT_DOMAIN="ojs-riara.localhost"
SERVERNAME="$PROJECT_DOMAIN"

### Web Server Settings --------------------------------------------------------

HTTP_PORT=8888
HTTPS_PORT=8443

WEB_USER="www-data"
WEB_PATH="/var/www/html"
HTTPS=On

################################################################################
#### CAUTION: you probably don’t want to edit variables below this line #######
################################################################################

MYSQL_USER="${DB_USER}"
MYSQL_DATABASE="${DB_NAME}"
MYSQL_PASSWORD="${DB_PASS}"
MYSQL_ROOT_PASSWORD="${DB_PASS}"

PKP_CLI_INSTALL=0
PKP_DB_DRIVER=mysqli
PKP_DB_HOST="${DB_HOST}"
PKP_DB_NAME="${DB_NAME}"
PKP_DB_USER="${DB_USER}"
PKP_DB_PASSWORD="${DB_PASS}"
PKP_WEB_CONF="/etc/apache2/conf-enabled/pkp.conf"
PKP_CONF="/var/www/html/config.inc.php"

BUILD_PKP_APP_OS="alpine:3.22"
BUILD_PKP_APP_PATH="/app"
